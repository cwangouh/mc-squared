POSTGRES_DB=formula_trainer
POSTGRES_USER=formula_trainer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
APP_PORT=8080
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=./data/media

# S3-compatible storage. Required only when MEDIA_STORAGE_TYPE=s3.
S3_ENDPOINT=https://s3.example.com
S3_REGION=region-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=true

DB_URL=jdbc:postgresql://localhost:55432/formula_trainer
DB_USERNAME=formula_trainer
DB_PASSWORD=change-me

ADMIN_USERNAME=admin
# Escape $ as $$ for Docker Compose interpolation.
ADMIN_PASSWORD_HASH=$$2a$$10$$10iMR0mIACkXv7QUMnJ2iODWtxsBHWzNBc7thK4W2TtDWQsBXmhXK
