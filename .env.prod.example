# Docker image published by the CI pipeline.
APP_IMAGE=registry.gitlab.com/group/formula-trainer/backend:latest
APP_PORT=8080

# External PostgreSQL database. Add the SSL mode required by your provider.
DB_URL=jdbc:postgresql://db.example.com:5432/formula_trainer?sslmode=require
DB_USERNAME=formula_trainer
DB_PASSWORD=change-me

MEDIA_STORAGE_TYPE=s3
S3_ENDPOINT=https://s3.example.com
S3_REGION=region-1
S3_BUCKET=formula-trainer
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_PATH_STYLE_ACCESS=true

ADMIN_USERNAME=admin
# Single quotes preserve the dollar signs in a BCrypt hash.
ADMIN_PASSWORD_HASH='$2a$10$replaceWithARealBCryptHash'
